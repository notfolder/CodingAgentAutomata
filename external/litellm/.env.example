# LiteLLM Proxy との連携に使う環境変数の一覧（値はダミー）
# 実際の値はプロジェクト直下の .env にだけ書く。

# consumer が使う LiteLLM Proxy の URL（opencode には末尾に /v1 を付けて渡す）
LITELLM_PROXY_URL=http://litellm:4000

# LiteLLM Proxy（実 LLM モード）が Anthropic へ転送するときの API キー
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# LiteLLM Proxy の管理用のキー（テスト環境で Virtual Key を発行するときに使う）
LITELLM_MASTER_KEY=your_litellm_master_key_here
